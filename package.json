{
  "name": "comdraft-lambda",
  "version": "0.1.0",
  "private": true,
  "description": "comdraft AI 초안 작성 Lambda (구분 → 분석 → 작성)",
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "build": "esbuild src/handler.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/index.mjs --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" && pnpm smoke",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@aws-sdk/client-sts": "^3.1165.0",
    "@mozilla/readability": "^0.6.0",
    "dayjs": "1.11.23",
    "linkedom": "^0.18.15",
    "marked": "17.0.6",
    "postgres": "3.4.9",
    "undici": "^8.12.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.152",
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  }
}
